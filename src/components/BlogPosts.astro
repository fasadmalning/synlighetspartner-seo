---
try {
  // Conectamos directamente con los posts de tu web online pidiendo hasta 10 entradas
  const response = await fetch('https://synlighetspartner.se/wp-json/wp/v2/posts?per_page=10');
  var posts = await response.json();
} catch (error) {
  var posts = [];
}
---

<section style="max-width: 800px; margin: 40px auto; padding: 20px; background: #ffffff; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
  <h2 style="color: #1e293b; text-align: center; margin-bottom: 20px;">Reflektioner från Synlighetspartner</h2>
  
  <div style="display: flex; flex-direction: column; gap: 25px;">
    {posts.length > 0 ? (
      posts.map((post: any) => (
        <article style="padding: 20px; border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc;">
          <h3 style="margin: 0 0 15px 0; font-size: 20px; color: #0f172a;" set:html={post.title.rendered} />
          <!-- Aquí cambiamos el excerpt por el content para mostrar todo el texto -->
          <div style="color: #334155; font-size: 15px; line-height: 1.6;" set:html={post.content.rendered} />
        </article>
      ))
    ) : (
      <p style="text-align: center; color: #64748b;">No se pudieron cargar las reflexiones en este momento.</p>
    )}
  </div>
</section>